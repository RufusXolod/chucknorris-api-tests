{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["total", "result"],
  "properties": {
    "total": { "type": "integer", "minimum": 0 },
    "result": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "value"],
        "properties": {
          "id":    { "type": "string", "minLength": 1 },
          "url":   { "type": "string" },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}